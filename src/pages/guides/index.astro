---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../lib/site.mjs';
---
<Base lang="en" title="Guides" desc="Guides written for this site." slug="guides/">
  <h1>Guides</h1>
  <div class="grid">
    {SITE.guides.map((guide) => (
      <a class="card" href={`/guides/${guide.slug}/`}>
        <h3>{guide.en.h1}</h3>
        <p>{guide.en.desc}</p>
      </a>
    ))}
  </div>
</Base>
