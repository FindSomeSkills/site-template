---
import Base from '../../layouts/Base.astro';
import GuidePage from '../../components/GuidePage.astro';
import { SITE } from '../../lib/site.mjs';

export function getStaticPaths() {
  return SITE.guides.map((guide) => ({ params: { slug: guide.slug }, props: { guide } }));
}
const { guide } = Astro.props;
---
<Base lang="en" title={guide.en.title} desc={guide.en.desc} slug={`guides/${guide.slug}/`}>
  <GuidePage lang="en" guide={guide} />
</Base>
